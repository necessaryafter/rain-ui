{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rain UI Contract Schema v0",
  "description": "JSON Schema for Rain UI screen contracts (schemaVersion 0)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "properties",
    "actions",
    "root"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 0,
      "description": "Contract schema version \u2014 only 0 is supported in M1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[a-z0-9_/-]+$",
      "description": "Screen identifier in Minecraft namespace format (namespace:path)"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/TypeSchema"
      },
      "description": "Root-level data properties the server sends to this screen"
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/TypeSchema"
      },
      "maxProperties": 256,
      "description": "Actions this screen can dispatch, mapped to payload schemas"
    },
    "root": {
      "$ref": "#/definitions/ComponentNode",
      "description": "Root component node of the screen's layout tree"
    }
  },
  "definitions": {
    "TypeSchema": {
      "oneOf": [
        {
          "$ref": "#/definitions/TypeString"
        },
        {
          "$ref": "#/definitions/TypeInt"
        },
        {
          "$ref": "#/definitions/TypeLong"
        },
        {
          "$ref": "#/definitions/TypeDouble"
        },
        {
          "$ref": "#/definitions/TypeBool"
        },
        {
          "$ref": "#/definitions/TypeItem"
        },
        {
          "$ref": "#/definitions/TypeList"
        },
        {
          "$ref": "#/definitions/TypeObject"
        }
      ],
      "description": "Type schema for properties, actions, and object fields"
    },
    "TypeString": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "string"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        },
        "default": {
          "type": "string",
          "maxLength": 1024,
          "description": "Used when the value is absent or null; implies optional. Only allowed in properties"
        }
      },
      "additionalProperties": false
    },
    "TypeInt": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "int"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        },
        "default": {
          "type": "integer",
          "description": "Used when the value is absent or null; implies optional. Only allowed in properties"
        }
      },
      "additionalProperties": false
    },
    "TypeLong": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "long"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        },
        "default": {
          "type": "integer",
          "description": "Used when the value is absent or null; implies optional. Only allowed in properties"
        }
      },
      "additionalProperties": false
    },
    "TypeDouble": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "double"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        },
        "default": {
          "type": "number",
          "description": "Used when the value is absent or null; implies optional. Only allowed in properties"
        }
      },
      "additionalProperties": false
    },
    "TypeBool": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "bool"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        },
        "default": {
          "type": "boolean",
          "description": "Used when the value is absent or null; implies optional. Only allowed in properties"
        }
      },
      "additionalProperties": false
    },
    "TypeItem": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "item"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        }
      },
      "additionalProperties": false
    },
    "TypeList": {
      "type": "object",
      "required": [
        "kind",
        "of"
      ],
      "properties": {
        "kind": {
          "const": "list"
        },
        "of": {
          "$ref": "#/definitions/TypeSchema"
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        }
      },
      "additionalProperties": false
    },
    "TypeObject": {
      "type": "object",
      "required": [
        "kind",
        "fields"
      ],
      "properties": {
        "kind": {
          "const": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/TypeSchema"
          }
        },
        "optional": {
          "const": true,
          "description": "The value may be absent or null"
        }
      },
      "additionalProperties": false
    },
    "ComponentNode": {
      "type": "object",
      "required": [
        "type",
        "props",
        "children"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "column",
            "row",
            "text",
            "item",
            "button",
            "list",
            "show",
            "match",
            "case",
            "default",
            "fallback"
          ],
          "description": "Component type"
        },
        "props": {
          "type": "object",
          "description": "Component properties (structure varies by type)"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentNode"
          },
          "description": "Child component nodes"
        }
      },
      "additionalProperties": false
    }
  }
}
