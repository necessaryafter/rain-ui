{
  "schemaVersion": 0,
  "id": "shop:main",
  "properties": {
    "items": {
      "kind": "list",
      "of": {
        "kind": "object",
        "fields": {
          "id": {
            "kind": "string"
          },
          "name": {
            "kind": "string"
          },
          "priceLabel": {
            "kind": "string"
          },
          "icon": {
            "kind": "item"
          },
          "locked": {
            "kind": "bool"
          }
        }
      }
    }
  },
  "actions": {
    "shop:buy": {
      "kind": "object",
      "fields": {
        "itemId": {
          "kind": "string"
        }
      }
    }
  },
  "root": {
    "type": "column",
    "props": {
      "gap": 4,
      "padding": 8
    },
    "children": [
      {
        "type": "text",
        "props": {
          "value": "Loja"
        },
        "children": []
      },
      {
        "type": "list",
        "props": {
          "source": {
            "$bind": "items"
          }
        },
        "children": [
          {
            "type": "row",
            "props": {
              "gap": 4
            },
            "children": [
              {
                "type": "item",
                "props": {
                  "value": {
                    "$bind": "icon"
                  }
                },
                "children": []
              },
              {
                "type": "text",
                "props": {
                  "value": {
                    "$bind": "name"
                  }
                },
                "children": []
              },
              {
                "type": "text",
                "props": {
                  "value": {
                    "$bind": "priceLabel"
                  }
                },
                "children": []
              },
              {
                "type": "button",
                "props": {
                  "action": "shop:buy",
                  "payload": {
                    "itemId": {
                      "$bind": "id"
                    }
                  },
                  "disabled": {
                    "$bind": "locked"
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "props": {
                      "value": "Comprar"
                    },
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
